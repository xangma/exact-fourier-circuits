 let env ← getEnv
 for (name, _) in env.constants.toList do
  if "_private.UniformLocalFourierLayers.".isPrefixOf name.toString then
   let axs ← collectAxioms name
   logInfo m!"{name} depends on axioms: {axs.toList}"
